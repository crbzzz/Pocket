# Local development. Set production only after configuring the services below.
POCKET_MODE=demo
PORT=4310

# Supabase (server-side credentials)
DATABASE_URL=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Ephemeral compute
DAYTONA_API_KEY=
DAYTONA_SNAPSHOT=pocket-small-node
POCKET_PUBLIC_URL=http://localhost:4310

# GitHub App (private key accepts literal \n inside quotes)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_TOKEN_ENCRYPTION_KEY=
GITHUB_WEBHOOK_SECRET=
WORKER_DISPATCH_SECRET=

# Enable only configured providers; define model IDs and pricing in MODEL_CATALOG.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
MODEL_CATALOG=[]

# Cloud deployment (local tooling only; never bundled in the app)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
SUPABASE_ACCESS_TOKEN=
